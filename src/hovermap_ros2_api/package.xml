<?xml version="1.0"?>
<package format="3">
  <name>hovermap_ros2_api</name>
  <version>0.1.0</version>
  <description>Native ROS 2 Jazzy control and Mule adapter for Hovermap.</description>
  <maintainer email="kinesis@nyu.edu">KINESIS Core Technology Platforms</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>hovermap_ros2_msgs</exec_depend>
  <!-- Avro is an imported Mule-core dependency with no upstream rosdep key.
       Install Ubuntu's python3-avro package as documented in the README. -->
  <exec_depend>python3-netifaces</exec_depend>
  <exec_depend>python3-tornado</exec_depend>
  <exec_depend>python3-zmq</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
