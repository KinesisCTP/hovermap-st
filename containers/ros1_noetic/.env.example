# Copy to .env to override local container defaults.

# Leave HOVERMAP_WS unset to mount the repository root.
# HOVERMAP_WS=/home/student/hovermap-st_ws

ROS_IMAGE=local/kinesis-hovermap-st-noetic:desktop
CONTAINER_NAME=kinesis_hovermap_st_noetic
CONTAINER_WORKSPACE=/home/ros/hovermap-st_ws

# Host directory used for completed and partial scan downloads.
# DOWNLOAD_DIR=/home/student/hovermap_scans
